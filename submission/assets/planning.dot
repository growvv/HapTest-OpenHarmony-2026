digraph G {graph[rankdir=LR,bgcolor="white",pad=.15,ranksep=.25];node[shape=box,fontname="Microsoft YaHei",fontsize=12,style="rounded,filled",fillcolor="#EAF7FD",color="#08A8F6"];edge[color="#708395"];a[label="当前观察\n截图与控件树"];b[label="候选动作\n任务与历史"];c[label="图文模型\nJSON 决策"];d[label="范围与状态校验\n默认预览"];e[label="执行一个动作\n旧观察失效"];a->b->c->d->e;e->a[label="重新观察",fontname="Microsoft YaHei"];}
